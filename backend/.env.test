# Test Environment Configuration
# This file is used for running tests

# Environment
NODE_ENV=test

# Database (use separate test database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medichain_test

# JWT Secrets (test values, not for production)
JWT_SECRET=test-jwt-secret-key-minimum-32-chars-long
JWT_REFRESH_SECRET=test-refresh-secret-key-minimum-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Hedera (testnet)
HEDERA_OPERATOR_ID=0.0.12345
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420test-private-key
HEDERA_NETWORK=testnet

# Hedera Topics (optional in test)
HEDERA_AUDIT_TOPIC=0.0.11111
HEDERA_RECORD_TOPIC=0.0.22222
HEDERA_CONSENT_TOPIC=0.0.33333

# Contracts (optional in test)
HEALTH_RECORD_CONTRACT=0.0.44444
DOCTOR_REGISTRY_CONTRACT=0.0.55555
ACCESS_CONTROL_CONTRACT=0.0.66666

# IPFS (use test token or mock)
WEB3_STORAGE_TOKEN=test-token

# Email (not required for tests)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=test@medichain.local

# Application
PORT=3001
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# Redis (local for tests)
REDIS_URL=redis://localhost:6379/1

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
MAX_FILE_SIZE_MB=10
